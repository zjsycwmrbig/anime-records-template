{% extends "base.njk" %}
{% from "icons.njk" import icon %}

{% block bodyClass %}insights-page{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ assetRoot }}insights.css?v={{ assetVersion }}" />
{% endblock %}

{% block content %}
  <section class="insights-hero-band" aria-labelledby="insights-title">
    <div class="page-shell insights-hero">
      <div class="insights-heading">
        <p class="eyebrow">INSIGHTS / 数据洞察</p>
        <h1 id="insights-title">档案的轨迹</h1>
        <p>把收录节奏、作品年份、评分习惯和索引覆盖放进几个清晰的视图里。</p>
        <div class="insights-hero-actions">
          <button class="share-trigger insights-share-trigger" data-share-trigger data-share-kind="overview" type="button" aria-haspopup="dialog" title="选择模块并导出档案洞察图">
            {{ icon("share") }}<span>分享洞察图</span>
          </button>
        </div>
      </div>
      <dl class="insights-snapshot" aria-label="档案摘要">
        <div><dt>作品总数</dt><dd>{{ insights.summary.total }}</dd></div>
        <div><dt>平均评分</dt><dd>{{ insights.summary.averageRating }}</dd></div>
        <div><dt>评分覆盖</dt><dd>{{ insights.summary.ratedPercent }}%</dd></div>
        <div><dt>本月新增</dt><dd>{{ insights.summary.latestMonth }}</dd></div>
        <div><dt>评分中位数</dt><dd>{{ insights.summary.medianRating }}</dd></div>
        <div><dt>评分范围</dt><dd>{{ insights.summary.lowestRating }}-{{ insights.summary.highestRating }}</dd></div>
      </dl>
    </div>
  </section>

  <div class="page-shell insights-shell">
    {% if insights.summary.total %}
      <nav class="insights-tabs" role="tablist" aria-label="数据概览模块">
        <button class="insight-tab is-active" id="tab-dashboard" role="tab" aria-selected="true" aria-controls="panel-dashboard" data-insights-tab="dashboard">数据概览</button>
        <button class="insight-tab" id="tab-rhythm" role="tab" aria-selected="false" aria-controls="panel-rhythm" data-insights-tab="rhythm">收录趋势</button>
        <button class="insight-tab" id="tab-years" role="tab" aria-selected="false" aria-controls="panel-years" data-insights-tab="years">年份分布</button>
        <button class="insight-tab" id="tab-ratings" role="tab" aria-selected="false" aria-controls="panel-ratings" data-insights-tab="ratings">评分分布</button>
        {% if insights.tagRadar.available %}
          <button class="insight-tab" id="tab-tags" role="tab" aria-selected="false" aria-controls="panel-tags" data-insights-tab="tags">标签偏好</button>
        {% endif %}
        <button class="insight-tab" id="tab-sources" role="tab" aria-selected="false" aria-controls="panel-sources" data-insights-tab="sources">公共数据缓存</button>
      </nav>

      <section class="insight-tab-panel is-active" id="panel-dashboard" role="tabpanel" aria-labelledby="tab-dashboard" data-insights-panel="dashboard">
        <div class="insights-carousel" data-carousel>
          <div class="carousel-toolbar">
            <div><p class="section-index">01 / DASHBOARD</p><h3>数据概览</h3></div>
            <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一组概览">←</button><span data-carousel-status aria-live="polite">1 / 2</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一组概览">→</button></div>
          </div>
          <div class="carousel-viewport">
            <article class="carousel-slide is-active" data-carousel-slide aria-label="档案构成">
              <div class="overview-card-grid">
                <div class="overview-card"><span>收录作品</span><strong>{{ insights.summary.total }}</strong><small>部作品</small></div>
                <div class="overview-card"><span>已评分</span><strong>{{ insights.summary.rated }}</strong><small>{{ insights.summary.ratedPercent }}% 覆盖</small></div>
                <div class="overview-card"><span>有短评</span><strong>{{ insights.summary.reviewed }}</strong><small>{{ insights.summary.reviewedPercent }}% 覆盖</small></div>
                <div class="overview-card"><span>有备注</span><strong>{{ insights.summary.noted }}</strong><small>{{ insights.summary.notedPercent }}% 覆盖</small></div>
                <div class="overview-card"><span>平均评分</span><strong>{{ insights.summary.averageRating }}</strong><small>10 分制</small></div>
                <div class="overview-card"><span>评分中位数</span><strong>{{ insights.summary.medianRating }}</strong><small>{{ insights.summary.lowestRating }}-{{ insights.summary.highestRating }} 区间</small></div>
                <div class="overview-card"><span>年份覆盖</span><strong>{{ insights.summary.seasonPercent }}%</strong><small>可参与年代分析</small></div>
                <div class="overview-card overview-card-accent"><span>公共缓存覆盖</span><strong>{{ insights.summary.publicCache.coveragePercent }}%</strong><small>{{ insights.summary.publicCache.cached }} / {{ insights.summary.total }} 部已缓存</small></div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="收录窗口">
              <div class="window-grid">
                {% for window in insights.windows %}
                  <article class="window-stat"><span>{{ window.label }}</span><strong>{{ window.count }}</strong><small>部新增</small></article>
                {% endfor %}
                <article class="window-stat window-stat-accent"><span>本月新增</span><strong>{{ insights.summary.latestMonth }}</strong><small>按添加日期统计</small></article>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="insight-tab-panel" id="panel-rhythm" role="tabpanel" aria-labelledby="tab-rhythm" data-insights-panel="rhythm" hidden>
        <div class="insights-carousel" data-carousel>
          <div class="carousel-toolbar">
            <div><p class="section-index">02 / RHYTHM</p><h3>收录趋势</h3></div>
            <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一个趋势视图">←</button><span data-carousel-status aria-live="polite">1 / 4</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一个趋势视图">→</button></div>
          </div>
          <div class="carousel-viewport">
            <article class="carousel-slide is-active" data-carousel-slide aria-label="年度收录日历热力图">
              <div class="slide-heading activity-heading">
                <div><strong>收录热力图</strong><span>{{ insights.activity.startLabel }} 至 {{ insights.activity.endLabel }} · 按记录创建日期统计</span></div>
                <div class="activity-week-stat"><span>近 7 天新增</span><strong>{{ insights.activity.lastWeekCount }}</strong><small>部作品</small></div>
              </div>
              <div class="activity-calendar" style="--activity-weeks: {{ insights.activity.weeks.length }}" role="img" aria-label="过去五十三周每日收录热力图">
                <div class="activity-month-row">
                  {% for month in insights.activity.monthLabels %}
                    <span style="grid-column: {{ month.weekIndex + 1 }}">{{ month.label }}</span>
                  {% endfor %}
                </div>
                <div class="activity-calendar-body">
                  <div class="activity-weekdays" aria-hidden="true">
                    <span>一</span><span>三</span><span>五</span>
                  </div>
                  <div class="activity-grid">
                    {% for week in insights.activity.weeks %}
                      {% for day in week.days %}
                        <span class="activity-day level-{{ day.level }}{% if day.future %} is-future{% endif %}" title="{{ day.label }}" aria-label="{{ day.label }}"></span>
                      {% endfor %}
                    {% endfor %}
                  </div>
                </div>
                <div class="activity-footer">
                  <span>过去一年共新增 {{ insights.activity.total }} 部</span>
                  <div class="activity-scale" aria-label="热力图颜色图例"><span>少</span>{% for level in [0, 1, 2, 3, 4] %}<i class="level-{{ level }}"></i>{% endfor %}<span>多</span></div>
                </div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="本月每日收录">
              <div class="slide-heading"><strong>本月每日收录</strong><span>按记录创建日期统计</span></div>
              <div class="chart-scroll">
                <div class="month-chart day-chart" style="--chart-columns: {{ insights.days.length }}" role="img" aria-label="本月每日新增收录柱状图">
                  {% for day in insights.days %}
                    <div class="month-column" title="{{ day.label }}：{{ day.count }} 部"><span class="month-value">{{ day.count }}</span><span class="month-bar-track"><span class="month-bar{% if day.count == 0 %} is-empty{% endif %}" style="--bar-size: {{ day.percent }}%"></span></span><span class="month-label">{{ day.shortLabel }}</span></div>
                  {% endfor %}
                </div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="近八周收录">
              <div class="slide-heading"><strong>近八周收录</strong><span>以七天为一个统计窗口</span></div>
              <div class="month-chart week-chart" role="img" aria-label="近八周新增收录柱状图">
                {% for week in insights.weeks %}
                  <div class="month-column" title="{{ week.label }}：{{ week.count }} 部"><span class="month-value">{{ week.count }}</span><span class="month-bar-track"><span class="month-bar{% if week.count == 0 %} is-empty{% endif %}" style="--bar-size: {{ week.percent }}%"></span></span><span class="month-label">{{ week.shortLabel }}</span></div>
                {% endfor %}
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="最近十二个月">
              <div class="slide-heading"><strong>最近十二个月</strong><span>按记录创建时间统计</span></div>
              <div class="month-chart" role="img" aria-label="最近十二个月新增收录柱状图">
                {% for month in insights.months %}
                  <div class="month-column" title="{{ month.label }}：{{ month.count }} 部"><span class="month-value">{{ month.count }}</span><span class="month-bar-track"><span class="month-bar{% if month.count == 0 %} is-empty{% endif %}" style="--bar-size: {{ month.percent }}%"></span></span><span class="month-label">{{ month.shortLabel }}</span></div>
                {% endfor %}
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="insight-tab-panel" id="panel-years" role="tabpanel" aria-labelledby="tab-years" data-insights-panel="years" hidden>
        <div class="insights-carousel" data-carousel>
          <div class="carousel-toolbar">
            <div><p class="section-index">03 / YEAR</p><h3>年份分布</h3></div>
            <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一个年份视图">←</button><span data-carousel-status aria-live="polite">1 / 3</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一个年份视图">→</button></div>
          </div>
          <div class="carousel-viewport">
            <article class="carousel-slide is-active" data-carousel-slide aria-label="年代分布扇状图">
              <div class="pie-layout">
                <div class="interactive-pie" data-interactive-pie>
                  <div class="year-pie" role="img" aria-label="作品按十年聚合的年代分布扇状图" style="background: conic-gradient({% for segment in insights.decadePieSegments %}{{ segment.color }} {{ segment.start }}% {{ segment.end }}%{% if not loop.last %}, {% endif %}{% endfor %})"></div>
                  <output class="pie-tooltip" hidden></output>
                </div>
                <div class="pie-legend" aria-label="年代图例">
                  {% for segment in insights.decadePieSegments %}
                    <div class="pie-legend-row" tabindex="0" data-pie-segment data-label="{{ segment.label }}" data-count="{{ segment.count }}" data-percent="{{ segment.percent }}" data-start="{{ segment.start }}" data-end="{{ segment.end }}"><i style="--legend-color: {{ segment.color }}"></i><span>{{ segment.label }}</span><strong>{{ segment.count }} 部</strong><small>{{ segment.percent }}%</small></div>
                  {% endfor %}
                </div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="年份分布扇状图">
              <div class="pie-layout">
                <div class="interactive-pie" data-interactive-pie>
                  <div class="year-pie" role="img" aria-label="作品逐年分布扇状图" style="background: conic-gradient({% for segment in insights.pieSegments %}{{ segment.color }} {{ segment.start }}% {{ segment.end }}%{% if not loop.last %}, {% endif %}{% endfor %})"></div>
                  <output class="pie-tooltip" hidden></output>
                </div>
                <div class="pie-legend" aria-label="年份图例">
                  {% for segment in insights.pieSegments %}
                    <div class="pie-legend-row" tabindex="0" data-pie-segment data-label="{{ segment.label }}" data-count="{{ segment.count }}" data-percent="{{ segment.percent }}" data-start="{{ segment.start }}" data-end="{{ segment.end }}"><i style="--legend-color: {{ segment.color }}"></i><span>{{ segment.label }}</span><strong>{{ segment.count }} 部</strong><small>{{ segment.percent }}%</small></div>
                  {% endfor %}
                </div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="逐年分布">
              <div class="slide-heading"><strong>逐年分布</strong><span>作品年份 · 评分完成度</span></div>
              <section class="insights-filter-bar" aria-label="分析筛选">
                <div><span class="section-index">FILTER / 细分查看</span><p id="insights-filter-summary">调整年份范围、逐年排序和评分明细。</p></div>
                <label><span>年份范围</span><input id="insights-year-min" type="number" min="1900" max="2200" placeholder="起始年" aria-label="分析起始年份" /><span aria-hidden="true">-</span><input id="insights-year-max" type="number" min="1900" max="2200" placeholder="结束年份" aria-label="分析结束年份" /></label>
                <label><span>逐年排序</span><select id="insights-year-sort"><option value="year-desc">年份：新到旧</option><option value="year-asc">年份：旧到新</option><option value="count-desc">数量：多到少</option><option value="average-desc">均分：高到低</option></select></label>
                <label><span>评分明细</span><select id="insights-rating-filter"><option value="all">全部评分</option><option value="high">8 分及以上</option><option value="mid">6 - 7.9 分</option><option value="low">低于 6 分</option></select></label>
              </section>
              <div id="year-distribution" class="distribution-list year-distribution">
                {% for year in insights.years %}
                  <div class="distribution-row" data-year="{{ year.key or '' }}" data-count="{{ year.count }}" data-average="{{ year.averageRating }}"><span class="distribution-label">{{ year.label }}</span><span class="distribution-track"><span class="distribution-bar" style="--bar-size: {{ year.percent }}%"></span></span><span class="distribution-count">{{ year.count }} 部</span><span class="distribution-note">均分 {{ year.averageRating }} · 已评 {{ year.ratedPercent }}%</span></div>
                {% endfor %}
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="insight-tab-panel" id="panel-ratings" role="tabpanel" aria-labelledby="tab-ratings" data-insights-panel="ratings" hidden>
        <div class="insights-carousel" data-carousel>
          <div class="carousel-toolbar">
            <div><p class="section-index">04 / SCORE</p><h3>评分分布</h3></div>
            <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一个评分视图">←</button><span data-carousel-status aria-live="polite">1 / 5</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一个评分视图">→</button></div>
          </div>
          <div class="carousel-viewport">
            <article class="carousel-slide is-active" data-carousel-slide aria-label="评分区间扇状图">
              <div class="pie-layout">
                <div class="interactive-pie" data-interactive-pie>
                  <div class="year-pie rating-pie" role="img" aria-label="作品评分区间分布扇状图" style="background: conic-gradient({% for segment in insights.ratingPieSegments %}{{ segment.color }} {{ segment.start }}% {{ segment.end }}%{% if not loop.last %}, {% endif %}{% endfor %})"></div>
                  <output class="pie-tooltip" hidden></output>
                </div>
                <div class="pie-legend" aria-label="评分区间图例">
                  {% for segment in insights.ratingPieSegments %}
                    <div class="pie-legend-row" tabindex="0" data-pie-segment data-label="{{ segment.label }}" data-count="{{ segment.count }}" data-percent="{{ segment.percent }}" data-start="{{ segment.start }}" data-end="{{ segment.end }}"><i style="--legend-color: {{ segment.color }}"></i><span>{{ segment.label }}</span><strong>{{ segment.count }} 部</strong><small>{{ segment.percent }}%</small></div>
                  {% endfor %}
                </div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="评分区间">
              <div class="rating-distribution">
                {% for rating in insights.ratings %}
                  <div class="rating-row{% if rating.key == 'unrated' %} is-muted{% endif %}"><span>{{ rating.label }}</span><span class="rating-track"><span class="rating-bar" style="--bar-size: {{ rating.percent }}%"></span></span><strong>{{ rating.count }}</strong><small>{{ rating.percent }}%</small></div>
                {% endfor %}
              </div>
              <div class="highlight-note"><span>评分中位数</span><strong>{{ insights.summary.medianRating }} / 10</strong><small>{{ insights.summary.rated }} 部已评分</small></div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="精确评分">
              <div class="slide-heading"><strong>精确到 0.1 分</strong><span>{{ insights.summary.rated }} 部已评分</span></div>
              <div class="rating-fine-list rating-fine-list-large">
                {% for rating in insights.ratingFine %}
                  <div class="rating-fine-item" data-rating="{{ rating.key }}" title="{{ rating.label }}：{{ rating.count }} 部"><span>{{ rating.key }}</span><span class="rating-fine-track"><span style="--bar-size: {{ rating.percent }}%"></span></span><strong>{{ rating.count }}</strong></div>
                {% endfor %}
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="按年代拆分评分">
              <div class="slide-heading"><strong>按年代拆分</strong><span>每个年代的评分构成与平均分</span></div>
              {% if insights.ratingByDecade.length %}
                <div class="rating-breakdown-list">
                  {% for group in insights.ratingByDecade %}
                    <section class="rating-breakdown-row">
                      <header><div><strong>{{ group.label }}</strong><small>{{ group.rated }} 部已评分 · {{ group.count }} 部收录</small></div><em>{{ group.averageRating }}</em></header>
                      <div class="rating-breakdown-track" aria-label="{{ group.label }}评分构成">
                        {% for bucket in group.buckets %}
                          {% if bucket.count %}<span class="rating-breakdown-segment is-{{ bucket.className }}" style="--segment-size: {{ bucket.percent }}%" title="{{ bucket.label }}：{{ bucket.count }} 部"></span>{% endif %}
                        {% endfor %}
                      </div>
                      <div class="rating-breakdown-legend">
                        {% for bucket in group.buckets %}
                          {% if bucket.count %}<span><i class="is-{{ bucket.className }}"></i>{{ bucket.shortLabel }} · {{ bucket.count }}</span>{% endif %}
                        {% endfor %}
                      </div>
                    </section>
                  {% endfor %}
                </div>
              {% else %}
                <p class="panel-empty">当前没有可用于年代拆分的评分记录。</p>
              {% endif %}
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="按标签拆分评分">
              <div class="slide-heading slide-heading-with-control">
                <strong>按标签拆分</strong>
                <label class="insight-inline-sort">
                  <span>排序</span>
                  <select id="insights-tag-rating-sort" aria-label="按标签拆分评分排序">
                    <option value="average-desc">均分：高到低</option>
                    <option value="average-asc">均分：低到高</option>
                    <option value="count-desc">数量：多到少</option>
                    <option value="count-asc">数量：少到多</option>
                    <option value="rated-desc">已评分：多到少</option>
                    <option value="rated-asc">已评分：少到多</option>
                  </select>
                </label>
              </div>
              {% if insights.ratingByTag.length %}
                <div class="rating-breakdown-list rating-breakdown-tags">
                  {% for group in insights.ratingByTag %}
                    <section class="rating-breakdown-row" data-tag-count="{{ group.count }}" data-tag-rated="{{ group.rated }}" data-tag-average="{% if group.averageRating != '—' %}{{ group.averageRating }}{% endif %}">
                      <header><div><strong>{{ group.label }}</strong><small>{{ group.rated }} 部已评分 · {{ group.count }} 部带此标签</small></div><em>{{ group.averageRating }}</em></header>
                      <div class="rating-breakdown-track" aria-label="{{ group.label }}评分构成">
                        {% for bucket in group.buckets %}
                          {% if bucket.count %}<span class="rating-breakdown-segment is-{{ bucket.className }}" style="--segment-size: {{ bucket.percent }}%" title="{{ bucket.label }}：{{ bucket.count }} 部"></span>{% endif %}
                        {% endfor %}
                      </div>
                      <div class="rating-breakdown-legend">
                        {% for bucket in group.buckets %}
                          {% if bucket.count %}<span><i class="is-{{ bucket.className }}"></i>{{ bucket.shortLabel }} · {{ bucket.count }}</span>{% endif %}
                        {% endfor %}
                      </div>
                    </section>
                  {% endfor %}
                </div>
              {% else %}
                <p class="panel-empty">当前没有可用于标签拆分的评分记录。</p>
              {% endif %}
            </article>
          </div>
        </div>
      </section>

      {% if insights.tagRadar.available %}
        <section class="insight-tab-panel" id="panel-tags" role="tabpanel" aria-labelledby="tab-tags" data-insights-panel="tags" hidden>
          <div class="insights-carousel" data-carousel>
            <div class="carousel-toolbar">
              <div><p class="section-index">05 / TAGS</p><h3>标签偏好</h3></div>
              <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一个标签视图">←</button><span data-carousel-status aria-live="polite">1 / 3</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一个标签视图">→</button></div>
            </div>
            <div class="carousel-viewport">
              <article class="carousel-slide is-active" data-carousel-slide aria-label="标签偏好多边形图">
                <div class="tag-radar-layout">
                  <div class="tag-radar-visual" data-tag-radar>
                    <div class="tag-radar-svg" data-tag-radar-svg role="img" aria-label="番剧标签偏好多边形图"></div>
                    <output class="tag-radar-tooltip" data-tag-radar-tooltip hidden></output>
                  </div>
                  <div class="tag-radar-side">
                    <div class="tag-radar-highlight">
                      <span>最高频标签</span>
                      <strong>{{ insights.tagRadar.topTag.label }}</strong>
                      <small>出现在 {{ insights.tagRadar.topTag.count }} 部有标签的作品中</small>
                    </div>
                    <div class="tag-radar-ranking-title"><span>标签排行</span><small>按出现作品数排序</small></div>
                    <div class="tag-radar-legend" aria-label="标签偏好图例">
                      {% for axis in insights.tagRadar.ranking %}
                        <div tabindex="0" data-tag-radar-legend data-tag-index="{{ axis.index }}" data-tag-label="{{ axis.label }}" data-tag-count="{{ axis.count }}" data-tag-percent="{{ axis.percent }}"><span>{{ axis.label }}</span><span class="tag-radar-legend-track"><i style="--tag-size: {{ axis.percent }}%"></i></span><strong>{{ axis.count }}</strong></div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </article>
              <article class="carousel-slide" data-carousel-slide aria-label="标签统计范围">
                <div class="tag-radar-method">
                  <div>
                    <span>统计口径</span>
                    <strong>{% if insights.tagRadar.mode == "manual" %}手动轴{% else %}自动高频轴{% endif %}</strong>
                    <p>每部作品中的同名标签只计一次；年份、媒介类型和手动排除标签不会进入统计。</p>
                  </div>
                  <dl>
                    <div><dt>当前轴数</dt><dd>{{ insights.tagRadar.axes.length }} / {{ insights.tagRadar.maxAxes }}</dd></div>
                    <div><dt>可用标签作品</dt><dd>{{ insights.tagRadar.coverage.tagged }}</dd></div>
                    <div><dt>排除标签</dt><dd>{{ insights.tagRadar.excludedTags.length }}</dd></div>
                    <div><dt>别名合并组</dt><dd>{{ insights.tagRadar.aliasGroups.length }}</dd></div>
                  </dl>
                </div>
              </article>
              <article class="carousel-slide" data-carousel-slide aria-label="标签评分偏离">
                <div class="slide-heading"><strong>标签评分偏离</strong><span>同时对照我的评分与公共评分，偏离值 = 我的平均 - 公共平均</span></div>
                {% if insights.tagRatingDeviation.length %}
                  <div class="tag-rating-deviation-list">
                    {% for group in insights.tagRatingDeviation %}
                      <section class="tag-rating-deviation-row">
                        <header>
                          <div><strong>{{ group.label }}</strong><small>{{ group.count }} 部带此标签 · 我的 {{ group.personalRated }} 部 · 公共 {{ group.publicRated }} 部</small></div>
                          <em class="is-{{ group.deviationTone }}">{{ group.deviationDisplay }}</em>
                        </header>
                        <div class="tag-rating-deviation-values">
                          <div><span>我的平均</span><strong>{{ group.personalAverageDisplay }}</strong></div>
                          <div><span>公共平均</span><strong>{{ group.publicAverageDisplay }}</strong></div>
                          <div><span>评分偏离</span><strong class="is-{{ group.deviationTone }}">{{ group.deviationDisplay }}</strong></div>
                        </div>
                        <div class="tag-rating-deviation-bars" aria-label="{{ group.label }}的我的评分与公共评分">
                          <span class="tag-rating-deviation-bar is-personal" style="--rating-size: {{ group.personalPercent }}%" title="我的平均评分：{% if group.personalAverage is not null %}{{ group.personalAverage.toFixed(1) }}{% else %}暂无{% endif %}"></span>
                          <span class="tag-rating-deviation-bar is-public" style="--rating-size: {{ group.publicPercent }}%" title="公共平均评分：{% if group.publicAverage is not null %}{{ group.publicAverage.toFixed(1) }}{% else %}暂无{% endif %}"></span>
                        </div>
                      </section>
                    {% endfor %}
                  </div>
                {% else %}
                  <p class="panel-empty">当前没有同时具备标签与评分数据的作品。</p>
                {% endif %}
              </article>
            </div>
          </div>
        </section>
      {% endif %}

      <section class="insight-tab-panel" id="panel-sources" role="tabpanel" aria-labelledby="tab-sources" data-insights-panel="sources" hidden>
        <div class="insights-carousel" data-carousel>
          <div class="carousel-toolbar">
            <div><p class="section-index">06 / CACHE</p><h3>公共数据缓存</h3></div>
            <div class="carousel-controls"><button type="button" class="carousel-button" data-carousel-prev aria-label="上一个缓存视图">←</button><span data-carousel-status aria-live="polite">1 / 3</span><button type="button" class="carousel-button" data-carousel-next aria-label="下一个缓存视图">→</button></div>
          </div>
          <div class="carousel-viewport">
            <article class="carousel-slide is-active" data-carousel-slide aria-label="公共数据缓存">
              <div class="cache-stat-grid">
                <div class="cache-stat"><span>缓存覆盖</span><strong>{{ insights.summary.publicCache.coveragePercent }}%</strong><small>{{ insights.summary.publicCache.cached }} / {{ insights.summary.total }} 部关联缓存</small></div>
                <div class="cache-stat"><span>公共评分</span><strong>{{ insights.summary.publicCache.scorePercent }}%</strong><small>{{ insights.summary.publicCache.scored }} 部有公共评分</small></div>
                <div class="cache-stat"><span>公共标签</span><strong>{{ insights.summary.publicCache.tagPercent }}%</strong><small>{{ insights.summary.publicCache.tagged }} 部有公共标签</small></div>
                <div class="cache-stat"><span>公共简介</span><strong>{{ insights.summary.publicCache.summaryPercent }}%</strong><small>{{ insights.summary.publicCache.summarized }} 部有公共简介</small></div>
                <div class="cache-stat"><span>本机缓存条目</span><strong>{{ insights.summary.publicCache.fileEntries }}</strong><small>当前公共数据缓存总量</small></div>
                <div class="cache-stat"><span>尚未覆盖</span><strong>{{ insights.summary.publicCache.missing }}</strong><small>可从全量获取补齐</small></div>
              </div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="站点索引">
              {% if insights.sources.length %}
                <div class="source-stack">{% for source in insights.sources %}<div class="source-row"><span>{{ source.label }}</span><span class="source-track"><span class="source-bar" style="--bar-size: {{ source.percent }}%"></span></span><strong>{{ source.count }}</strong></div>{% endfor %}</div>
              {% else %}<p class="panel-empty">还没有可统计的站点索引。</p>{% endif %}
              <div class="highlight-note"><span>外部索引覆盖</span><strong>{{ insights.summary.sourcePercent }}%</strong><small>季度信息覆盖 {{ insights.summary.seasonPercent }}%</small></div>
            </article>
            <article class="carousel-slide" data-carousel-slide aria-label="最佳年代">
              {% if insights.bestDecade %}<div class="best-era"><span>平均评分最高年代</span><strong>{{ insights.bestDecade.label }}</strong><em>{{ insights.bestDecade.averageRating }} / 10</em></div>{% endif %}
            </article>
          </div>
        </div>
      </section>
    {% else %}
      <section class="insights-empty" aria-labelledby="empty-title">
        <p class="section-index">01 / OVERVIEW</p><h2 id="empty-title">档案还没有可统计的数据</h2><p>添加第一部番剧后，这里会生成收录趋势、年份分布和评分分析。</p><a class="insights-primary-link" href="{{ homeUrl }}">返回档案</a>
      </section>
    {% endif %}
  </div>
  <script id="share-insights-data" type="application/json">{{ insights | json }}</script>
{% endblock %}

{% block scripts %}
  <script src="{{ assetRoot }}share.js?v={{ assetVersion }}" defer></script>
  <script src="{{ assetRoot }}insights.js?v={{ assetVersion }}" defer></script>
{% endblock %}
